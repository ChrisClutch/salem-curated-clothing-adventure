    const categories = ["All", "Thrift", "Vintage", "Consignment", "Boutique", "Kids", "Antique", "Free"];
    const priceFilters = ["All", "$", "$$", "$$$", "FREE"];

    function App() {
      const [selectedCategory, setSelectedCategory] = useState("All");
      const [selectedPrice, setSelectedPrice] = useState("All");
      const [searchQuery, setSearchQuery] = useState("");
      const [sortBy, setSortBy] = useState("rating");
      const [selectedStore, setSelectedStore] = useState(null);
      const [showRedditPicks, setShowRedditPicks] = useState(false);
      const [showNonprofits, setShowNonprofits] = useState(false);

      const filteredStores = useMemo(() => {
        let result = stores.filter(store => {
          const matchesCategory = selectedCategory === "All" || store.category === selectedCategory;
          const matchesPrice = selectedPrice === "All" || store.priceLevel === selectedPrice;
          const matchesSearch = store.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
                               store.address.toLowerCase().includes(searchQuery.toLowerCase()) ||
                               store.highlight.toLowerCase().includes(searchQuery.toLowerCase());
          const matchesReddit = !showRedditPicks || store.tags?.includes("reddit-pick") || store.tags?.includes("local-favorite");
          const matchesNonprofit = !showNonprofits || store.nonprofit;
          return matchesCategory && matchesPrice && matchesSearch && matchesReddit && matchesNonprofit;
        });

        return result.sort((a, b) => {
          if (a.featured && !b.featured) return -1;
          if (!a.featured && b.featured) return 1;
          if (sortBy === "rating") return (b.rating || 0) - (a.rating || 0);
          if (sortBy === "reviews") return b.reviews - a.reviews;
          if (sortBy === "name") return a.name.localeCompare(b.name);
          return 0;
        });
      }, [selectedCategory, selectedPrice, searchQuery, sortBy, showRedditPicks, showNonprofits]);

      const stats = useMemo(() => ({
        total: stores.length,
        thrift: stores.filter(s => s.category === "Thrift").length,
        vintage: stores.filter(s => s.category === "Vintage").length,
        consignment: stores.filter(s => s.category === "Consignment").length,
        nonprofit: stores.filter(s => s.nonprofit).length,
        totalReviews: stores.reduce((sum, s) => sum + s.reviews, 0),
      }), []);

      const getCategoryColor = (cat) => ({
        Thrift: "bg-emerald-500", Vintage: "bg-amber-500", Consignment: "bg-rose-500",
        Boutique: "bg-violet-500", Kids: "bg-sky-500", Antique: "bg-orange-600", Free: "bg-green-600"
      }[cat] || "bg-gray-500");

      const getPriceColor = (price) => {
        if (price === "FREE") return "text-green-500 font-bold";
        if (price === "$") return "text-emerald-600";
        if (price === "$$") return "text-amber-600";
        return "text-rose-600";
      };

      const StarRating = ({ rating, reviews }) => {
        if (!rating) return <span className="text-xs text-gray-400 italic">New listing</span>;
        return (
          <div className="flex items-center gap-1.5">
            <div className="flex">
              {[...Array(5)].map((_, i) => (
                <span key={i} className={`text-sm ${i < Math.round(rating) ? 'text-amber-400' : 'text-gray-300'}`}>★</span>
              ))}
            </div>
            <span className="text-sm font-semibold text-gray-700">{rating}</span>
            <span className="text-xs text-gray-400">({reviews.toLocaleString()})</span>
          </div>
        );
      };

      const SocialLinks = ({ store }) => {
        const links = [];
        if (store.website) links.push({ icon: "🌐", url: store.website, label: "Website" });
        if (store.instagram) links.push({ icon: "📸", url: store.instagram, label: "Instagram" });
        if (store.facebook) links.push({ icon: "📘", url: store.facebook, label: "Facebook" });
        if (store.tiktok) links.push({ icon: "🎵", url: store.tiktok, label: "TikTok" });
        
        if (links.length === 0) return null;
        
        return (
          <div className="flex items-center gap-2 mt-2 pt-2 border-t border-gray-100">
            <span className="text-xs text-gray-400">Social:</span>
            {links.map((link, i) => (
              <a key={i} href={link.url} target="_blank" rel="noopener noreferrer" 
                 onClick={(e) => e.stopPropagation()}
                 className="text-lg hover:scale-125 transition-transform" title={link.label}>
                {link.icon}
              </a>
            ))}
          </div>
        );
      };

      return (
        <div className="min-h-screen bg-gradient-to-br from-amber-50 via-white to-emerald-50">
          {/* Header */}
          <header className="relative overflow-hidden bg-gradient-to-r from-emerald-700 via-teal-700 to-emerald-800 text-white">
            <div className="absolute inset-0 opacity-10">
              <div className="absolute top-0 left-0 w-96 h-96 bg-white rounded-full -translate-x-1/2 -translate-y-1/2" />
              <div className="absolute bottom-0 right-0 w-72 h-72 bg-amber-300 rounded-full translate-x-1/3 translate-y-1/3" />
            </div>
            <div className="relative max-w-7xl mx-auto px-4 py-12">
              <div className="flex items-center gap-3 mb-2">
                <span className="text-4xl">🛍️</span>
                <span className="text-xs uppercase tracking-widest text-emerald-200 font-medium">Salem • Keizer • Surrounding Areas</span>
              </div>
              <h1 className="text-4xl md:text-5xl font-black tracking-tight mb-3">
                Salem Thrift & Vintage Directory
              </h1>
              <p className="text-lg text-emerald-100 max-w-2xl mb-6">
                The complete guide to secondhand shopping in the Willamette Valley. 
                <span className="font-semibold text-white"> {stats.total} stores</span> with over 
                <span className="font-semibold text-white"> {stats.totalReviews.toLocaleString()} reviews</span>.
              </p>
              
              <div className="flex flex-wrap gap-4 text-sm">
                <div className="bg-white/10 backdrop-blur px-4 py-2 rounded-lg">
                  <span className="text-emerald-200">Thrift:</span> <span className="font-bold">{stats.thrift}</span>
                </div>
                <div className="bg-white/10 backdrop-blur px-4 py-2 rounded-lg">
                  <span className="text-emerald-200">Vintage:</span> <span className="font-bold">{stats.vintage}</span>
                </div>
                <div className="bg-white/10 backdrop-blur px-4 py-2 rounded-lg">
                  <span className="text-emerald-200">Consignment:</span> <span className="font-bold">{stats.consignment}</span>
                </div>
                <div className="bg-white/10 backdrop-blur px-4 py-2 rounded-lg">
                  <span className="text-emerald-200">💙 Nonprofits:</span> <span className="font-bold">{stats.nonprofit}</span>
                </div>
              </div>
            </div>
          </header>

          {/* Filters */}
          <div className="sticky top-0 z-40 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
            <div className="max-w-7xl mx-auto px-4 py-4">
              <div className="flex flex-col lg:flex-row gap-4">
                <div className="flex-1">
                  <input
                    type="text"
                    placeholder="Search stores, addresses, or features..."
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    className="w-full px-4 py-3 rounded-xl border-2 border-gray-200 focus:border-emerald-500 focus:outline-none transition-colors text-gray-700"
                  />
                </div>
                
                <div className="flex flex-wrap gap-2">
                  {categories.map(cat => (
                    <button key={cat} onClick={() => setSelectedCategory(cat)}
                      className={`px-4 py-2 rounded-full text-sm font-medium transition-all ${
                        selectedCategory === cat
                          ? 'bg-emerald-600 text-white shadow-lg shadow-emerald-200'
                          : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                      }`}>
                      {cat}
                    </button>
                  ))}
                </div>
              </div>

              <div className="flex flex-wrap items-center gap-4 mt-3">
                <div className="flex items-center gap-2">
                  <span className="text-xs text-gray-500 uppercase tracking-wide">Price:</span>
                  {priceFilters.map(price => (
                    <button key={price} onClick={() => setSelectedPrice(price)}
                      className={`px-3 py-1 rounded-lg text-sm font-medium transition-all ${
                        selectedPrice === price ? 'bg-amber-500 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                      }`}>
                      {price}
                    </button>
                  ))}
                </div>

                <div className="flex items-center gap-2">
                  <span className="text-xs text-gray-500 uppercase tracking-wide">Sort:</span>
                  <select value={sortBy} onChange={(e) => setSortBy(e.target.value)}
                    className="px-3 py-1.5 rounded-lg border border-gray-200 text-sm text-gray-700 focus:outline-none focus:border-emerald-500">
                    <option value="rating">Highest Rated</option>
                    <option value="reviews">Most Reviews</option>
                    <option value="name">A-Z</option>
                  </select>
                </div>

                <button onClick={() => setShowRedditPicks(!showRedditPicks)}
                  className={`flex items-center gap-2 px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${
                    showRedditPicks ? 'bg-orange-500 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                  }`}>
                  <span>🔥</span> Reddit Favorites
                </button>

                <button onClick={() => setShowNonprofits(!showNonprofits)}
                  className={`flex items-center gap-2 px-4 py-1.5 rounded-lg text-sm font-medium transition-all ${
                    showNonprofits ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                  }`}>
                  <span>💙</span> Nonprofits
                </button>

                <span className="text-sm text-gray-500 ml-auto">
                  Showing {filteredStores.length} of {stores.length} stores
                </span>
              </div>
            </div>
          </div>

          {/* Store Grid */}
          <main className="max-w-7xl mx-auto px-4 py-8">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {filteredStores.map(store => (
                <article key={store.id} onClick={() => setSelectedStore(store)}
                  className={`store-card group bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 cursor-pointer border overflow-hidden ${
                    store.featured ? 'border-2 border-emerald-400 ring-2 ring-emerald-100 shadow-lg' : 'border-gray-100'
                  }`}>
                  <div className="p-5 pb-3">
                    <div className="flex items-start justify-between gap-3 mb-2">
                      <div className="flex-1">
                        <div className="flex flex-wrap items-center gap-1.5 mb-1">
                          <span className={`text-xs px-2 py-0.5 rounded-full text-white font-medium ${getCategoryColor(store.category)}`}>
                            {store.category}
                          </span>
                          {store.tags?.includes("reddit-pick") && (
                            <span className="text-xs px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 font-medium">🔥 Reddit</span>
                          )}
                          {store.tags?.includes("local-favorite") && (
                            <span className="text-xs px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 font-medium">♥ Local Fave</span>
                          )}
                          {store.featured && (
                            <span className="text-xs px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-medium">⭐ Featured</span>
                          )}
                          {store.nonprofit && (
                            <span className="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">💙 Nonprofit</span>
                          )}
                        </div>
                        <h3 className="text-lg font-bold text-gray-900 group-hover:text-emerald-700 transition-colors">
                          {store.name}
                        </h3>
                      </div>
                      <span className={`text-lg font-bold ${getPriceColor(store.priceLevel)}`}>
                        {store.priceLevel}
                      </span>
                    </div>
                    <StarRating rating={store.rating} reviews={store.reviews} />
                  </div>

                  <div className="px-5 pb-4">
                    <p className="text-sm text-emerald-700 font-medium mb-3 leading-relaxed">
                      💡 {store.highlight}
                    </p>
                    
                    {store.nonprofit && store.nonprofitNote && (
                      <p className="text-xs text-blue-700 bg-blue-50 px-2 py-1 rounded mb-2">
                        💙 {store.nonprofitNote}
                      </p>
                    )}
                    
                    {store.note && (
                      <p className="text-xs text-amber-700 bg-amber-50 px-2 py-1 rounded mb-2">
                        ⚠️ {store.note}
                      </p>
                    )}

                    <div className="space-y-1.5 text-sm text-gray-600">
                      <div className="flex items-start gap-2">
                        <span className="text-gray-400">📍</span>
                        <span className="leading-tight">{store.address}</span>
                      </div>
                      <div className="flex items-center gap-2">
                        <span className="text-gray-400">🕐</span>
                        <span>{store.hours}</span>
                      </div>
                      {store.phone && (
                        <div className="flex items-center gap-2">
                          <span className="text-gray-400">📞</span>
                          <a href={`tel:${store.phone}`} className="text-emerald-600 hover:underline" onClick={(e) => e.stopPropagation()}>
                            {store.phone}
                          </a>
                        </div>
                      )}
                    </div>

                    <SocialLinks store={store} />
                  </div>

                  <div className="px-5 py-3 bg-gray-50 border-t border-gray-100">
                    <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(store.name + ' ' + store.address)}`}
                      target="_blank" rel="noopener noreferrer" onClick={(e) => e.stopPropagation()}
                      className="text-sm text-emerald-600 hover:text-emerald-700 font-medium flex items-center gap-1">
                      🗺️ Get Directions
                    </a>
                  </div>
                </article>
              ))}
            </div>

            {filteredStores.length === 0 && (
              <div className="text-center py-16">
                <span className="text-6xl mb-4 block">🔍</span>
                <h3 className="text-xl font-bold text-gray-700 mb-2">No stores found</h3>
                <p className="text-gray-500">Try adjusting your filters or search terms</p>
              </div>
            )}
          </main>

          {/* Footer */}
          <footer className="bg-gray-900 text-white py-12 mt-12">
            <div className="max-w-7xl mx-auto px-4 text-center">
              <h3 className="text-2xl font-bold mb-2">Salem Thrift & Vintage Directory</h3>
              <p className="text-gray-400 mb-6">Supporting local businesses and sustainable shopping in the Willamette Valley</p>
              <div className="flex flex-wrap justify-center gap-6 text-sm text-gray-400">
                <span>🏪 {stats.total} Stores</span>
                <span>⭐ {stats.totalReviews.toLocaleString()} Reviews</span>
                <span>💙 {stats.nonprofit} Nonprofits</span>
                <span>📍 Salem • Keizer • Dallas • Stayton</span>
              </div>
              <p className="mt-6 text-xs text-gray-500">
                Data sourced from Google Places & Reddit r/Salem • Last updated March 2026
              </p>
            </div>
          </footer>

          {/* Modal */}
          {selectedStore && (
            <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm" onClick={() => setSelectedStore(null)}>
              <div className="bg-white rounded-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto shadow-2xl" onClick={(e) => e.stopPropagation()}>
                <div className={`${getCategoryColor(selectedStore.category)} p-6 text-white`}>
                  <div className="flex justify-between items-start">
                    <div>
                      <span className="text-xs uppercase tracking-wide opacity-80">{selectedStore.category}</span>
                      <h2 className="text-2xl font-bold mt-1">{selectedStore.name}</h2>
                    </div>
                    <button onClick={() => setSelectedStore(null)} className="text-white/80 hover:text-white text-2xl">×</button>
                  </div>
                  <StarRating rating={selectedStore.rating} reviews={selectedStore.reviews} />
                </div>
                <div className="p-6 space-y-4">
                  <div className="bg-emerald-50 rounded-lg p-4">
                    <p className="text-emerald-800 font-medium">💡 {selectedStore.highlight}</p>
                  </div>
                  
                  {selectedStore.nonprofit && selectedStore.nonprofitNote && (
                    <div className="bg-blue-50 rounded-lg p-4">
                      <p className="text-blue-800">💙 <span className="font-medium">Nonprofit:</span> {selectedStore.nonprofitNote}</p>
                    </div>
                  )}
                  
                  {selectedStore.note && (
                    <div className="bg-amber-50 rounded-lg p-4">
                      <p className="text-amber-800">⚠️ {selectedStore.note}</p>
                    </div>
                  )}

                  <div className="space-y-3">
                    <div className="flex items-start gap-3">
                      <span className="text-xl">📍</span>
                      <div>
                        <p className="font-medium text-gray-900">Address</p>
                        <p className="text-gray-600">{selectedStore.address}</p>
                      </div>
                    </div>
                    <div className="flex items-start gap-3">
                      <span className="text-xl">🕐</span>
                      <div>
                        <p className="font-medium text-gray-900">Hours</p>
                        <p className="text-gray-600">{selectedStore.hours}</p>
                      </div>
                    </div>
                    {selectedStore.phone && (
                      <div className="flex items-start gap-3">
                        <span className="text-xl">📞</span>
                        <div>
                          <p className="font-medium text-gray-900">Phone</p>
                          <a href={`tel:${selectedStore.phone}`} className="text-emerald-600 hover:underline">{selectedStore.phone}</a>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Social Links in Modal */}
                  {(selectedStore.website || selectedStore.instagram || selectedStore.facebook || selectedStore.tiktok) && (
                    <div className="border-t pt-4">
                      <p className="font-medium text-gray-900 mb-3">Social Media & Website</p>
                      <div className="flex flex-wrap gap-2">
                        {selectedStore.website && (
                          <a href={selectedStore.website} target="_blank" rel="noopener noreferrer"
                            className="flex items-center gap-2 px-3 py-2 bg-gray-100 rounded-lg text-sm hover:bg-gray-200 transition-colors">
                            🌐 Website
                          </a>
                        )}
                        {selectedStore.instagram && (
                          <a href={selectedStore.instagram} target="_blank" rel="noopener noreferrer"
                            className="flex items-center gap-2 px-3 py-2 bg-gradient-to-r from-purple-100 to-pink-100 rounded-lg text-sm hover:from-purple-200 hover:to-pink-200 transition-colors">
                            📸 Instagram
                          </a>
                        )}
                        {selectedStore.facebook && (
                          <a href={selectedStore.facebook} target="_blank" rel="noopener noreferrer"
                            className="flex items-center gap-2 px-3 py-2 bg-blue-100 rounded-lg text-sm hover:bg-blue-200 transition-colors">
                            📘 Facebook
                          </a>
                        )}
                        {selectedStore.tiktok && (
                          <a href={selectedStore.tiktok} target="_blank" rel="noopener noreferrer"
                            className="flex items-center gap-2 px-3 py-2 bg-gray-900 text-white rounded-lg text-sm hover:bg-gray-800 transition-colors">
                            🎵 TikTok
                          </a>
                        )}
                      </div>
                    </div>
                  )}

                  <div className="pt-4 flex gap-3">
                    <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(selectedStore.name + ' ' + selectedStore.address)}`}
                      target="_blank" rel="noopener noreferrer"
                      className="flex-1 bg-emerald-600 text-white text-center py-3 rounded-xl font-medium hover:bg-emerald-700 transition-colors">
                      🗺️ Get Directions
                    </a>
                    {selectedStore.phone && (
                      <a href={`tel:${selectedStore.phone}`}
                        className="flex-1 bg-gray-100 text-gray-700 text-center py-3 rounded-xl font-medium hover:bg-gray-200 transition-colors">
                        📞 Call
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>

